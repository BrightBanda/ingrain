rules_version = '2';

// The Flutter client writes its own data, so these rules ARE the authorisation.
// Deny-by-default is the only thing protecting a user's vocabulary, SRS state and
// immersion history from every other account.
service cloud.firestore {
  match /databases/{database}/documents {
    // A signed-in user may do anything inside their own tree, and nothing outside it.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Nothing else is readable or writable — the catalogue is served by the FastAPI
    // service, not from Firestore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
